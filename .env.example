# 本地开发示例：复制到 .env 后在本机填写密码，不提交真实 .env。
# 保留已有的 POSTGRES_PASSWORD，不要为了复制示例覆盖已配置的真实密码。
POSTGRES_PASSWORD=''

# 正式应用的本地数据库连接地址；密码单独读取。
DATABASE_URL='postgres://medstudy@127.0.0.1:13445/medstudy?sslmode=disable'

# JWT 的 HS256 签名密钥：先生成至少 32 字节随机数据，再做标准 Base64 编码。
# 本地可运行 openssl rand -base64 32，并把输出填入真实 .env；不要提交真实密钥。
JWT_SIGNING_KEY_BASE64=''

# 不读取配置文件时，连接集成测试也支持直接提供此环境变量。
# 推荐运行时显式设置 MEDSTUDY_TEST_ENV_FILE 为真实 .env 路径，
# 测试会使用其中的 DATABASE_URL 与 POSTGRES_PASSWORD，不必 source。
# 这里同样指向本地开发库，不是独立测试数据库。
MEDSTUDY_TEST_DATABASE_URL='postgres://medstudy@127.0.0.1:13445/medstudy?sslmode=disable'

# sslmode=disable 仅适用于当前本机开发连接，不作为生产 TLS 配置。
